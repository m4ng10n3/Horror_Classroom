    text: Eh..ma lo voglio lo stesso.
  - speaker: 1
    text: Beh allora se mi vai a prendere dei pezzi di tessuto da Nicole.
  - speaker: 0
    text: Ti do in prestito la palla.
  - speaker: 0
    text: "E perch\xE9 vorresti dei pezzi di tessuto?"
  - speaker: 1
    text: Mi servono per metterci il cloroformio.
  - speaker: 1
    text: Secondo te come ho vinto il torneo?
  - speaker: 0
    text: Damn...
  completedSequence:
  - speaker: 0
    text: Tieni, ho preso il tessuto.
  - speaker: 1
    text: Crazy, Ora posso prepararmi al prossimo torneo.
  - speaker: 0
    text: Dammi il pallone ora.
  - speaker: 1
    text: Tieni tieni.
  repeatSequences:
  - lines:
    - speaker: 1
      text: Non ho altro da darti.
    - speaker: 0
      text: Capisco, grazie comunque.
  itemDialogueTriggers: []
  essential: 0
  tradeDone: 0
  requiredItem: Tessuto
  additionalRequiredItems:
  - Cloroformio
  introChainDialogue:
    lines:
    - speaker: 1
      text: We ma non sei venuto a fare il tifo al mio torneo!
    - speaker: 0
      text: Scusa dovevo lavorare...
    - speaker: 1
      text: Damn! Ma i bambini non lavorano!
    - speaker: 0
      text: Damn! Dammi il tuo pallone!
    - speaker: 1
      text: Ehi porta rispetto! Stai parlando con il vincitore del torneo!
    - speaker: 0
      text: "S\xEC ok... lo voglio lo stesso!"
    - speaker: 1
      text: Devi portarmi un paio di cose allora!
    - speaker: 0
      text: E ti pareva...
  introChainDialogueShown: 0
  tradeSteps:
  - requiredItem: Tessuto
    consumeItem: 1
    requestDialogue:
      lines:
      - speaker: 1
        text: Prendimi dei pezzi di tessuto da Nicole!
      - speaker: 0
        text: "E perch\xE9 vorresti dei pezzi di tessuto?"
      - speaker: 1
        text: Ovvio per metterci il cloroformio!
      - speaker: 1
        text: Secondo te come ho vinto il torneo!
      - speaker: 0
        text: ...
    receivedDialogue:
      lines: []
    completed: 0
  - requiredItem: Cloroformio
    consumeItem: 1
    requestDialogue:
      lines:
      - speaker: 1
        text: Voglio del cloroformio!
      - speaker: 0
        text: "Che devi farci\u2026? No ok non far\xF2 domande.. Tranne..\r\n"
      - speaker: 0
        text: Dove diavolo lo vado a prendere del cloroformio?
      - speaker: 1
        text: "Ho visto una boccetta prima in fondo all\u2019aula. Sai che ci gioco
          sempre!"
    receivedDialogue:
      lines:
      - speaker: 0
        text: "Tieni il cloroformio\u2026"
      - speaker: 1
        text: Perfetto.
      - speaker: 0
        text: Ma non voglio guai.
      - speaker: 1
        text: Ok sfigato.
    completed: 0
  finalChainDialogue:
    lines:
    - speaker: 0
      text: Dammi il pallone...ORA!
    - speaker: 0
      text: Tieni tieni.
  rewardItem: Pallone Da Calcio
  consumeRequiredItem: 1
  rewardItemPrefab: {fileID: 2613632856586992849, guid: fec66354396ba2b4b97d17f26a3e930a, type: 3}
  rewardItemDescription: "Chiss\xE0 come fa Frank a vincere se nemmeno si allena
    con la palla"
  rewardItemCanInspect: 1
  rewardItemInspectionScaleMultiplier: 1
