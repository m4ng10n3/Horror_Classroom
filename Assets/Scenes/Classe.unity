  gougeRewardDescription: 
  gougeRewardCanInspect: 1
  gougeRewardInspectionScaleMultiplier: 1
  gougeDialogue:
    lines:
    - speaker: 0
      text: "Stai fermo. Sar\xE0 solo un secondo."
    - speaker: 1
      text: No... no, ti prego, NO!!!!
  afterGougeSequences: []
