  studentName: Mark
  studentColor: {r: 0.7058824, g: 0.54901963, b: 0.78431374, a: 1}
  missingItemSequence: []
  completedSequence:
  - speaker: 1
    text: Dovresti venire a pesca con mio padre la prossima domenica.
  - speaker: 0
    text: A me piace mangiare il salmone.
  - speaker: 1
    text: Figo, a me piace mangiare lo sgombro.
  - speaker: 0
    text: Che schifo!
  - speaker: 0
    text: Scommetto che hai l'alito puzzolente!
  - speaker: 1
    text: Wow! Che modi!
  - speaker: 1
    text: "Non sei pi\xF9 invitato!"
  repeatSequences:
  - lines:
    - speaker: 1
      text: Non ho niente da darti.
    - speaker: 0
      text: Capisco, grazie comunque.
