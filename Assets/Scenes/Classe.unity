  studentColor: {r: 0.23529412, g: 0.54901963, b: 0.627451, a: 1}
  missingItemSequence:
  - speaker: 0
    text: Ciao Leo puoi prestarmi per favore il temperino?
  - speaker: 1
    text: Guardah
  - speaker: 1
    text: "Sto temperino \xE8 demoniaco"
  - speaker: 1
    text: Fa delle punte che...
  - speaker: 1
    text: Fanno PAURA!
  - speaker: 0
    text: Damn
  - speaker: 1
    text: Guardah
  - speaker: 1
    text: Se mi riesci a dare il guantone da box di Daniel
  - speaker: 1
    text: Forse riesco finalmente a smussare la punta da PAURA delle matite
  - speaker: 0
    text: Ok, faccio quello che posso
  completedSequence:
  - speaker: 0
    text: Eccoci, spero che io sia in tempo per darti i Guantoni
  - speaker: 1
    text: Guardah, Sei appena in tempo
  - speaker: 1
    text: Queste matite stavano per infilzare tutti
  - speaker: 1
    text: Anche il cane di Sam
  - speaker: 0
    text: Dammi ora il temperino
  - speaker: 1
    text: Guardah, devi essere attento
  - speaker: 1
    text: Fa delle punte da PAURA!
  repeatSequences:
  - lines:
