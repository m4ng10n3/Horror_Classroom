  useSceneChainPreset: 1
  studentName: Rachel
  studentColor: {r: 0.39215687, g: 0.39215687, b: 0.39215687, a: 1}
  missingItemSequence: []
  completedSequence:
  - speaker: 0
    text: 'Ciao Rachel '
  - speaker: 0
    text: Avrei bisogno di 1 bottone della tua collezione
  - speaker: 0
    text: Me lo regali?
  - speaker: 1
    text: 'Damn Della mia collezione? Sei impazzito? '
  - speaker: 1
    text: "Tuttavia\u2026 "
  - speaker: 1
    text: 'Mia nonna mi ha regalato un sacchetto di bottoni identici, non ci faccio
      nulla. '
  - speaker: 1
    text: Tienili pure tutti e quattro. Spero ricambierai il favore durante la mia
      interrogazione di domani.
  repeatSequences:
  - lines:
    - speaker: 1
      text: Non ho altro da darti.
    - speaker: 0
      text: Capisco, grazie comunque.
  itemDialogueTriggers: []
  essential: 0
  tradeDone: 0
  requiredItem: 
  rewardItem: Bottone
  consumeRequiredItem: 1
