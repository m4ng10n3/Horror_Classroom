  missingItemSequence:
  - speaker: 0
    text: Hey Nicole!
  - speaker: 0
    text: Hai qualche ritaglio di tessuto che ti avanza?
  - speaker: 0
    text: Vorrei prenderne un paio.
  - speaker: 1
    text: "Certo, prendi quelli che vuoi. Io non li uso pi\xF9."
  - speaker: 0
    text: Sei la Goat.
  - speaker: 1
    text: Aspetta!
  - speaker: 0
    text: Cosa?
  - speaker: 1
    text: Hai una matita da prestarmi?
  - speaker: 0
    text: "S\xEC. Torno con la matita."
  completedSequence:
  - speaker: 0
    text: Ecco la matita!
  - speaker: 1
    text: Ti ringrazio. Prendi il tessuto che vuoi.
  - speaker: 0
    text: Grazie.
  repeatSequences:
  - lines:
    - speaker: 1
      text: Non ho altro da darti.
    - speaker: 0
      text: Ok...
