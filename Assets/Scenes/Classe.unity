  studentName: George
  studentColor: {r: 0.3137255, g: 0.47058824, b: 0.3137255, a: 1}
  missingItemSequence:
  - speaker: 1
    text: Ehi nerd dammi un paio di forbici prima che ti tiro un pugno!
  - speaker: 0
    text: Provaci se ha il coraggio!
  - speaker: 1
    text: Servito! *TUNG*
  - speaker: 0
    text: Damn che male, bel guanto me lo presti?
  - speaker: 1
    text: Ti ho detto di darmi le forbici
  - speaker: 1
    text: "in pi\xF9 ti do dieci pugni, allora forse ti dar\xF2 il guanto. "
  - speaker: 0
    text: 'Damn '
  completedSequence:
  - speaker: 0
    text: Tieni le forbici....sono pronto dammi i pugni!
  - speaker: 1
    text: Ehi nerd sei abbastanza in gamba, tieni il guantone, vediamo quanti pugni
      riesci a tirare, per stavolta passi.
  repeatSequences:
  - lines:
    - speaker: 0
      text: "George voglio diventare un pugile ho deciso, la violenza \xE8 divertente!"
    - speaker: 1
      text: Bravo nerd!
  - lines:
    - speaker: 1
      text: "Con questa forbice diventer\xF2 un assassino"
    - speaker: 1
      text: Bravo nerd!
