  studentName: Eva
  studentColor: {r: 0.19607843, g: 0.6666667, b: 0.6666667, a: 1}
  missingItemSequence:
  - speaker: 0
    text: Quanti taglierini hai sul banco!
  - speaker: 1
    text: "Si una \xE8 per il braccio sinistro."
  - speaker: 1
    text: "Una \xE8 per quello destro."
  - speaker: 1
    text: Uno per i piedi.
  - speaker: 1
    text: L'altro...
  - speaker: 1
    text: PER LA GOLA!
  - speaker: 0
    text: 'Ehm..ok. Me ne presti uno? '
  - speaker: 1
    text: Ti do quello che ho in tasca. Ma prima ho bisogno di uno scotch.
  - speaker: 0
    text: Scotch?
  - speaker: 1
    text: "S\xEC devo riattaccare una lama che si \xE8 staccata."
  - speaker: 0
    text: "Non credo basti lo scotch\u2026"
  - speaker: 1
    text: Portalo e basta!
  - speaker: 1
    text: "O user\xF2 uno dei taglierini su di te."
  - speaker: 0
    text: ...
  completedSequence:
  - speaker: 0
    text: Tieni lo scotch.
  - speaker: 1
    text: Ecco a te il taglierino.
  - speaker: 0
    text: Grazie!
  - speaker: 1
    text: Ringrazia te stesso... per non avermi permesso di farti del male.
  - speaker: 0
    text: ...
  repeatSequences:
  - lines:
    - speaker: 1
      text: Non ho altro da darti.
    - speaker: 0
      text: Capisco, grazie comunque.
