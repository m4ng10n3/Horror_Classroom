  studentColor: {r: 0.6666667, g: 0.53333336, b: 0.19607843, a: 1}
  missingItemSequence: []
  completedSequence:
  - speaker: 0
    text: "Carlos\u2026 "
  - speaker: 0
    text: "puoi smettere di\u2026 "
  - speaker: 0
    text: "s\xEC insomma\u2026 "
  - speaker: 0
    text: "di usare quell\u2019accendino su qualsiasi cosa ti capiti sotto mano\u2026"
  - speaker: 1
    text: "Perch\xE9?"
  - speaker: 1
    text: "A te non rimangono pi\xF9 cose da incendiare? "
  - speaker: 1
    text: Vorresti essere un piromane anche tu vero?
  - speaker: 0
    text: "S\xEC"
  repeatSequences:
  - lines:
    - speaker: 1
      text: Non ho altro da darti.
    - speaker: 0
      text: Capisco, grazie comunque.
