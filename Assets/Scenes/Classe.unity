  missingItemSequence:
  - speaker: 0
    text: 'Ciao Michael per caso hai dello scotch? '
  - speaker: 1
    text: "Certo che ce l\u2019ho, che domande! E chiamami Jackson"
  - speaker: 1
    text: "Ma non te lo posso prestare, devo attaccare tutti questi fogli ancora\u2026 "
  - speaker: 1
    text: A meno che tu non torni con il pallone di Frank. Voglio giocarci durante
      la ricreazione
  completedSequence:
  - speaker: 1
    text: Hee hee
  - speaker: 1
    text: "Vedo che hai il pallone gi\xE0"
  - speaker: 1
    text: AU
  - speaker: 0
    text: Sono pronto per lo scambio
  - speaker: 1
    text: HEE HEE
  repeatSequences:
  - lines:
    - speaker: 1
      text: Non ho altro da darti.
    - speaker: 0
      text: Capisco, grazie comunque.
