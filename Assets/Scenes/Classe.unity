    - speaker: 1
      text: Quello che ho trovato.
    - speaker: 0
      text: "Perch\xE9 dovrei saperlo?"
    - speaker: 1
      text: Non lo so.
    - speaker: 0
      text: ...
    - speaker: 1
      text: "Ok\u2026te lo dico io. Una chiave."
    - speaker: 0
      text: Dalla a me!
    - speaker: 1
      text: "No! L\u2019ho trovata io."
    - speaker: 0
      text: Se ti do qualcosa in cambio?
    - speaker: 1
      text: "Mh\u2026 Ok. Ma non te la caverai con una cosa sola!"
  introChainDialogueShown: 0
  tradeSteps:
  - requiredItem: Macchinina
    consumeItem: 1
    requestDialogue:
      lines:
      - speaker: 1
        text: Voglio la macchinina verde.
      - speaker: 0
        text: Quale macchinina?
      - speaker: 1
        text: "Quella in fondo all\u2019aula."
    receivedDialogue:
      lines:
      - speaker: 0
        text: Ho la macchinina. Tieni.
      - speaker: 1
        text: Perfetto!
      - speaker: 0
        text: Ora tu dammi la chiave!
      - speaker: 1
        text: Non mi ha ancora portato tutto o sbaglio?
      - speaker: 0
        text: ...
    completed: 0
  - requiredItem: Patatine
    consumeItem: 1
    requestDialogue:
      lines:
      - speaker: 1
        text: "Vorrei proprio delle patatine\u2026"
      - speaker: 0
        text: Mi hai preso per un distributore automatico?
      - speaker: 1
        text: "Le ho viste sul banco di Will\u2026"
      - speaker: 0
        text: Smettila!
      - speaker: 1
        text: Niente patatine, niente chiave.
    receivedDialogue:
      lines:
      - speaker: 0
        text: Ho trovato le patatine.
      - speaker: 1
        text: Siiii! Patatine
      - speaker: 0
        text: Tieni...
      - speaker: 1
        text: MA SONO AVARIATE!
      - speaker: 0
        text: Sono quelle di Will. Quelle che mi hai chiesto.
      - speaker: 1
        text: "Non le voglio pi\xF9. Non ti dar\xF2 la chiave."
      - speaker: 0
        text: "Non \xE8 colpa mia! Sei un bugiardo."
      - speaker: 1
        text: Non sei affatto gentile.
      - speaker: 0
        text: Vuoi vedere con quanta gentilezza ti appendo al muro?
      - speaker: 1
        text: Sei cattivo.
      - speaker: 0
        text: Sto perdendo la pazienza...
    completed: 0
  - requiredItem: Peluche Spaventoso
    consumeItem: 1
    requestDialogue:
      lines:
      - speaker: 1
        text: "Voglio il peluche di Daniel.. ma con due occhi sarebbe molto pi\xF9
          bello."
      - speaker: 0
        text: E... questi occhi dove li trovo?
      - speaker: 1
        text: IO VEDO TANTI OCCHI IN QUESTA CLASSE!
      - speaker: 0
        text: ...
    receivedDialogue:
      lines:
      - speaker: 0
        text: HO IL DANNATO PUPAZZETTO. COSA MI HAI FATTO FARE?!
      - speaker: 1
        text: "SO CHE TI \xC8 PIACIUTO! "
      - speaker: 0
        text: 'TU SEI PAZZO! '
    completed: 0
  finalChainDialogue:
    lines:
    - speaker: 1
      text: Tieni questa stupidissima chiave. MA A COSA TI SERVE?
    - speaker: 0
      text: A STARE LONTANO DA TE!
  rewardItem: Chiave
  consumeRequiredItem: 0
  rewardItemPrefab: {fileID: 1544191590021391022, guid: 8bafd1a332cdb8747bf7ff72e3d84985, type: 3}
  rewardItemDescription: Chiavi che ha trovato Brad
  rewardItemCanInspect: 1
  rewardItemInspectionScaleMultiplier: 1
  rewardUpgradePath:
    actionKey: 1
    actionLabel: Inserisci occhio
    stages: []
    nextStageIndex: 0
  canGougeEye: 0
  gougeRequiredItem: Coltello
  gougeAlternativeItems:
  - Taglierino
  consumeItemsOnGouge: 1
  eyeGouged: 0
  gougeRewardItem: Occhio
  gougeRewardPrefab: {fileID: 543946042260495957, guid: 75b15e17d3113e04d86b74d19b163c37, type: 3}
  gougeRewardDescription: 
  gougeRewardCanInspect: 1
  gougeRewardInspectionScaleMultiplier: 1
  gougeDialogue:
    lines:
    - speaker: 0
      text: "Stai fermo. Sar\xE0 solo un secondo."
    - speaker: 1
      text: No... no, ti prego, NO!!!!
  afterGougeSequences: []
  addFallbackInteractionCollider: 1
  fallbackInteractionRadius: 0.45
  fallbackInteractionHeight: 1.6
  deskItems: []
  isVisible: 1
