  studentName: Frank
  studentColor: {r: 0.7058824, g: 0.39215687, b: 0.23529412, a: 1}
  missingItemSequence:
  - speaker: 1
    text: We ma non sei venuto a fare il tifo al mio torneo!
  - speaker: 0
    text: Scusa dovevo lavorare
  - speaker: 1
    text: Damn
  - speaker: 1
    text: Ma i bambini non lavorano
  - speaker: 0
    text: Damn
  - speaker: 0
    text: Dammi il tuo pallone
  - speaker: 1
    text: We ma stai parlando con il vincitore del tonero
  - speaker: 0
    text: Eh ma lo voglio lo stesso
  - speaker: 1
    text: Beh allora se mi vai a prendere dei pezzi di tessuto da Nicole
  - speaker: 0
    text: Ti do in prestito la palla
  - speaker: 0
    text: "E perch\xE9 vorresti dei pezzi di tessuto?"
  - speaker: 1
    text: Mi servono per metterci il cloroformio
  - speaker: 1
    text: Secondo te come ho vinto il torneo
  - speaker: 0
    text: Damn
  completedSequence:
  - speaker: 0
    text: Tieni, ho preso il tessuto
  - speaker: 1
    text: Crazy, Ora posso prepararmi al prossimo torneo
  - speaker: 0
    text: Dammi il pallone ora
  - speaker: 1
    text: Tieni tieni
  repeatSequences:
  - lines:
    - speaker: 1
      text: Non ho altro da darti.
    - speaker: 0
      text: Capisco, grazie comunque.
